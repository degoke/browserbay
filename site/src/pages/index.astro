---
import '@fontsource-variable/bricolage-grotesque'
import '@fontsource-variable/instrument-sans'
import '@fontsource/dm-mono/400.css'
import '@fontsource/dm-mono/500.css'
import { Code } from 'astro:components'
import mark from '../assets/mark.svg?raw'
import { DESCRIPTION, EYEBROW, TAGLINE } from '../site.mjs'

// One inline copy of the mark: ink follows `color`, the filled slot follows --accent, so both themes use the same SVG.
const markSvg = mark
  .replace(/<title>.*?<\/title>\s*/s, '')
  .replaceAll('stroke="#1B1F3B"', 'stroke="currentColor"')
  .replace('fill="#2F6BFF"', 'class="accent"')

const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const docs = (path: string) => `${base}/docs/${path}`
const GITHUB = 'https://github.com/degoke/browserbay'
// astro.config.mjs always sets the site address, so these are absolute URLs.
const site = Astro.site as URL
const pageUrl = new URL(`${base}/`, site).href
const ogImage = new URL(`${base}/og/home.png`, site).href

const title = 'browserbay: self-hosted browsers for AI agents and automation'
const description = DESCRIPTION

// What search engines read to understand the page: a website, and the open-source software it describes.
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${pageUrl}#website`,
      url: pageUrl,
      name: 'browserbay',
      description,
      inLanguage: 'en'
    },
    {
      '@type': 'SoftwareApplication',
      '@id': `${pageUrl}#software`,
      name: 'browserbay',
      url: pageUrl,
      description,
      applicationCategory: 'DeveloperApplication',
      operatingSystem: 'Linux, macOS, Windows (Docker, Kubernetes)',
      isAccessibleForFree: true,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      license: 'https://opensource.org/licenses/MIT',
      image: ogImage,
      sameAs: [GITHUB],
      author: { '@type': 'Person', name: 'Adewoye Adegoke' }
    }
  ]
}

const driveCode = `import { chromium } from 'playwright'
import { createBrowserBay } from
  '@degoke/browserbay/client'

const box = createBrowserBay({
  url: 'https://browsers.example.com',
  apiKey
})

const slot = await box.acquire({
  runId: 'task-42',
  maxLifetimeSeconds: 1800
})
try {
  const browser = await chromium.connectOverCDP(
    slot.cdpUrl,
    { headers: slot.headers }
  )
  const context = browser.contexts()[0]
  const page =
    context.pages()[0] ?? (await context.newPage())
  await page.goto('https://example.com')
} finally {
  await slot.release()
}`

const watchCode = `// On your server: a second connection to the slot
const ws = new WebSocket(slot.cdpUrl, {
  headers: slot.headers
})

// Ask Chromium for frames, and send them on
await send('Page.startScreencast',
  { format: 'jpeg' }, sessionId)

// Turn the person's click into input
await send('Input.dispatchMouseEvent',
  { type: 'mousePressed', x, y,
    button: 'left', clickCount: 1 }, sessionId)`

const deployCode = `export BROWSERBAY_API_KEY="$(openssl rand -base64 24)"

docker run -d --name browserbay --restart always --init --stop-timeout 130 \\
  -p 127.0.0.1:8788:8788 -e BROWSERBAY_API_KEY \\
  ghcr.io/degoke/browserbay`

const features = [
  {
    label: 'Isolated',
    title: 'Every browser is its own context',
    body: 'Each slot has its own cookies, storage and cache on a shared Chromium. A client sees its own pages and nothing else on that Chromium. This is tested against real Chromium, including attempts to reach another slot.'
  },
  {
    label: 'Anywhere',
    title: 'Deploys anywhere, dials out',
    body: 'Run it on a VPS, a container platform or a Raspberry Pi. Nodes connect out to the relay, so a node can sit behind NAT, and no DevTools port is open anywhere.'
  },
  {
    label: 'Scales',
    title: 'Add capacity by adding nodes',
    body: 'Start with one container. When you need more browsers, run more nodes, on any machine, and the relay schedules across them.'
  },
  {
    label: 'Contained',
    title: 'Hard to leak, easy to clean up',
    body: 'Three separate secrets. A lease on every browser, so a crashed client cannot hold one forever. A protocol version check between relay and nodes.'
  }
]
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />
    <meta name="author" content="Adewoye Adegoke" />
    <meta name="theme-color" content="#EEF1F8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0C0F22" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="icon" href={`${base}/favicon.ico`} sizes="32x32" />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:site_name" content="browserbay" />
    <meta property="og:locale" content="en" />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={TAGLINE.join(' ')} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <script is:inline>
      // Follow the docs' theme choice when there is one, otherwise the system.
      try {
        var saved = localStorage.getItem('starlight-theme')
        if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved
      } catch (e) {}
    </script>
  </head>
  <body>
    <header class="nav">
      <a class="brand" href={`${base}/`} aria-label="browserbay home">
        <span class="mark" set:html={markSvg} />
        <span class="wordmark">browserbay</span>
      </a>
      <nav aria-label="Main">
        <a href={docs('quick-start/')}>Docs</a>
        <a href="#live-view">Live view</a>
        <a href={GITHUB}>GitHub</a>
        <button type="button" class="motion-toggle" id="motion-toggle" aria-pressed="false">Pause motion</button>
      </nav>
    </header>

    <main>
      <section class="hero">
        <div class="hero-head">
          <p class="eyebrow">{EYEBROW}</p>
          <h1>
            {
              TAGLINE.map((line, i) => (
                <>
                  <span class="beat">
                    {i === TAGLINE.length - 1 ? (
                      <>
                        {line.slice(0, -1)}
                        <span class="dot">.</span>
                      </>
                    ) : (
                      line
                    )}
                  </span>
                  {/* a real space between the lines: Astro's HTML compression drops whitespace between the spans */}
                  {' '}
                </>
              ))
            }
          </h1>
        </div>

        <div class="hero-body">
        <div class="hero-copy">
          <p class="lead">
            browserbay runs isolated Chromium browsers on infrastructure you control: a VPS, a Raspberry Pi,
            Kubernetes. Drive them with Playwright, Puppeteer or any agent over the DevTools protocol, and show a live
            view in your own app so a person can watch and take over.
          </p>
          <div class="cta">
            <a class="btn primary" href={docs('quick-start/')}>Quick start</a>
            <a class="btn" href={GITHUB}>View on GitHub</a>
          </div>
        </div>

        <figure class="bay" aria-label="Illustration of a box with six slots, some in use">
          <div class="bay-head">
            <span>node-1</span>
            <span id="bay-count">2 of 6 slots in use</span>
          </div>
          <div class="slots" id="slots">
            {
              [
                'task-42',
                null,
                'agent-7f3a',
                null,
                null,
                null
              ].map((run) => (
                <div class="slot" data-run={run ?? ''} data-on={run ? '' : undefined}>
                  <div class="slot-body">
                    <span class="dots"><i></i><i class="bar"></i></span>
                  </div>
                  <span class="slot-label">{run ?? 'free'}</span>
                </div>
              ))
            }
          </div>
          <figcaption>Slots are leased, so a busy box frees itself.</figcaption>
        </figure>
        </div>
      </section>

      <section class="section how" id="how">
        <div class="section-copy">
          <p class="eyebrow">How it works</p>
          <h2>Ask, drive, hand back</h2>
          <ol class="steps">
            <li>
              <strong>Ask.</strong> Acquire a slot with a run id and a lease. If the box is full it waits, then tells you.
            </li>
            <li>
              <strong>Drive.</strong> Connect Playwright, Puppeteer or anything that speaks the DevTools protocol.
            </li>
            <li>
              <strong>Hand back.</strong> Release it. If your process dies first, the lease closes the browser anyway.
            </li>
          </ol>
          <p class="clients">
            Clients for Node, Python and Go. Anything that speaks HTTP and WebSocket works too.
          </p>
          <a class="more" href={docs('quick-start/')}>Quick start →</a>
        </div>
        <div class="code"><Code code={driveCode} lang="js" theme="github-dark" /></div>
      </section>

      <section class="section live" id="live-view">
        <div class="viewer-wrap">
          <figure class="viewer" aria-label="Illustration of a live view: a person watching and clicking in a browser">
            <div class="viewer-bar">
              <span class="url">shop.example.com/checkout</span>
              <span class="pill"><i></i>live</span>
            </div>
            <div class="viewer-page">
              <div class="sk w60"></div>
              <div class="sk w40"></div>
              <div class="field"></div>
              <div class="field"></div>
              <div class="pay">Pay now</div>
              <svg class="cursor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M5 3v16l4.5-4 3 6.5 2.8-1.3-3-6.2H18z" />
              </svg>
              <span class="ripple"></span>
            </div>
            <div class="conns">
              <span><b>driver</b> Playwright · stepped away</span>
              <span><b>viewer</b> a person · steering</span>
            </div>
          </figure>
          <p class="note">Illustration. You build the viewer; the box supplies the stream.</p>
        </div>
        <div class="section-copy">
          <p class="eyebrow">Live view</p>
          <h2>Watch it. Steer it. Hand it back.</h2>
          <p>
            A slot takes more than one connection. Your service drives with Playwright. A person opens a second connection,
            watches a stream of frames, and clicks and types in the same page. When they step away, your service
            reconnects and finds the pages as they left them.
          </p>
          <ul class="points">
            <li>
              <strong>A second connection, not a takeover.</strong> The viewer does not push your driver off the slot.
            </li>
            <li>
              <strong>People never get DevTools.</strong> Your viewer turns their clicks and keys into input events.
              The slot token stays on your server.
            </li>
            <li>
              <strong>Priced in bandwidth.</strong> A page that repaints every frame costs about 2 MB/s per watcher. A
              still page costs almost nothing.
            </li>
          </ul>
          <div class="code small"><Code code={watchCode} lang="js" theme="github-dark" /></div>
          <a class="more" href={docs('guides/live-view/')}>Read the live view guide →</a>
        </div>
      </section>

      <section class="section features">
        <p class="eyebrow">What you get</p>
        <h2>Built to be left running</h2>
        <div class="feature-grid">
          {
            features.map((f) => (
              <article class="feature">
                <span class="tag">{f.label}</span>
                <h3>{f.title}</h3>
                <p>{f.body}</p>
              </article>
            ))
          }
        </div>
      </section>

      <section class="section raw">
        <div class="section-copy">
          <p class="eyebrow">Scope</p>
          <h2>The box and nothing on top</h2>
          <p>
            browserbay gives you a browser and stops there. No agent loop, no model calls, no crawler, no screenshot
            endpoint. That keeps the box small, and it lets one box serve a test suite, a scraper and an agent at the
            same time.
          </p>
        </div>
        <aside class="trust">
          <h3>Know what a slot token is</h3>
          <p>
            A slot token is control of a browser that runs on the node's machine. Give tokens to services you trust,
            run nodes on machines with nothing to steal, and run a box per party that should not trust each other.
          </p>
          <a class="more" href={docs('security/trust/')}>Trust and isolation →</a>
        </aside>
      </section>

      <section class="section deploy" id="deploy">
        <div class="section-copy">
          <p class="eyebrow">Deploy</p>
          <h2>Start with one container</h2>
          <p>
            The default image is a complete box: the relay and a Chromium node together. When you want browsers on
            several machines, run one relay and add nodes as you need them, anywhere. On Kubernetes, a Helm chart runs the
            relay once and the nodes as their own Deployment, so they scale on their own.
          </p>
          <div class="topology" role="img" aria-label="Your services connect to one relay. Nodes on several machines connect out to the relay.">
            <div class="col"><span>your services</span></div>
            <div class="arrow">→</div>
            <div class="col strong"><span>relay</span><small>one instance</small></div>
            <div class="arrow">←</div>
            <div class="col"><span>nodes</span><small>VPS, Pi, laptop</small></div>
          </div>
          <a class="more" href={docs('deploy/kubernetes/')}>Kubernetes →</a>
          <a class="more" href={docs('deploy/split/')}>Relay and nodes →</a>
        </div>
        <div class="code copyable">
          <Code code={deployCode} lang="sh" theme="github-dark" />
          <button type="button" class="copy" data-copy={deployCode}>Copy</button>
        </div>
      </section>
    </main>

    <footer class="foot">
      <a class="brand" href={`${base}/`} aria-label="browserbay home">
        <span class="mark" set:html={markSvg} />
        <span class="wordmark">browserbay</span>
      </a>
      <nav aria-label="Footer">
        <a href={docs('quick-start/')}>Docs</a>
        <a href={docs('guides/live-view/')}>Live view</a>
        <a href={docs('security/trust/')}>Trust</a>
        <a href={GITHUB}>GitHub</a>
        <a href={`${GITHUB}/blob/main/LICENSE`}>MIT license</a>
      </nav>
    </footer>

    <script is:inline>
      // The bay: slots take and give back browsers, a few at a time. Illustration only.
      ;(function () {
        var root = document.getElementById('slots')
        var count = document.getElementById('bay-count')
        if (!root) return
        var slots = Array.prototype.slice.call(root.children)
        var runs = ['task-42', 'agent-7f3a', 'invoice-1042', 'checkout-e2e', 'nightly-audit', 'signup-flow', 'run-9c1d']
        var update = function () {
          var used = slots.filter(function (s) { return s.hasAttribute('data-on') }).length
          if (count) count.textContent = used + ' of ' + slots.length + ' slots in use'
        }
        var tick = function () {
          var i = Math.floor(Math.random() * slots.length)
          var s = slots[i]
          var used = slots.filter(function (x) { return x.hasAttribute('data-on') }).length
          if (s.hasAttribute('data-on') && used > 1) {
            s.removeAttribute('data-on')
            s.querySelector('.slot-label').textContent = 'free'
          } else if (!s.hasAttribute('data-on') && used < slots.length - 1) {
            s.setAttribute('data-on', '')
            s.querySelector('.slot-label').textContent = runs[Math.floor(Math.random() * runs.length)]
          }
          update()
        }
        update()

        // Motion runs only while it is wanted: not paused, tab visible, bay on screen.
        var paused = false
        var onScreen = true
        var toggle = document.getElementById('motion-toggle')
        if (toggle) {
          toggle.addEventListener('click', function () {
            paused = !paused
            toggle.setAttribute('aria-pressed', String(paused))
            toggle.textContent = paused ? 'Play motion' : 'Pause motion'
            document.documentElement.toggleAttribute('data-motion-paused', paused)
          })
        }
        if ('IntersectionObserver' in window) {
          new IntersectionObserver(function (entries) { onScreen = entries[entries.length - 1].isIntersecting }).observe(root)
        }
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          setInterval(function () { if (!paused && onScreen && !document.hidden) tick() }, 2200)
        }
      })()

      document.addEventListener('click', function (event) {
        var button = event.target.closest && event.target.closest('[data-copy]')
        if (!button) return
        var done = function () {
          button.textContent = 'Copied'
          setTimeout(function () { button.textContent = 'Copy' }, 1600)
        }
        try {
          navigator.clipboard.writeText(button.getAttribute('data-copy')).then(done, function () {})
        } catch (e) {}
      })
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #f3f5fb;
    --surface: #ffffff;
    --ink: #1b1f3b;
    --muted: #565d86;
    --line: #d8dcee;
    --accent: #2f6bff;
    --accent-ink: #ffffff;
    --accent-text: #1f58e6;
    --code-bg: #12162e;
    --tint: #e6ebfb;
    --display: 'Bricolage Grotesque Variable', 'Helvetica Neue', Arial, sans-serif;
    --body: 'Instrument Sans Variable', 'Helvetica Neue', Arial, sans-serif;
    --mono: 'DM Mono', ui-monospace, Menlo, monospace;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) {
      --bg: #0c0f22;
      --surface: #141936;
      --ink: #e9ecfa;
      --muted: #9aa3d1;
      --line: #262c52;
      --accent: #5b8cff;
      --accent-ink: #0c0f22;
      --accent-text: #8fb0ff;
      --code-bg: #080a18;
      --tint: #181e40;
      color-scheme: dark;
    }
  }
  :root[data-theme='dark'] {
    --bg: #0c0f22;
    --surface: #141936;
    --ink: #e9ecfa;
    --muted: #9aa3d1;
    --line: #262c52;
    --accent: #5b8cff;
    --accent-ink: #0c0f22;
    --accent-text: #8fb0ff;
    --code-bg: #080a18;
    --tint: #181e40;
    color-scheme: dark;
  }
  :root[data-theme='light'] {
    color-scheme: light;
  }

  * {
    box-sizing: border-box;
  }
  html {
    scroll-behavior: smooth;
  }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font-family: var(--body);
    font-size: 17px;
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
  }
  a {
    color: inherit;
  }
  :focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 3px;
    border-radius: 4px;
  }
  h1,
  h2,
  h3 {
    font-family: var(--display);
    letter-spacing: -0.025em;
    margin: 0;
    text-wrap: balance;
  }
  p {
    margin: 0;
  }

  /* shell */
  .nav,
  main,
  .foot {
    width: 100%;
    max-width: 1160px;
    margin-inline: auto;
    padding-inline: 24px;
  }
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-block: 22px;
  }
  .nav nav,
  .foot nav {
    display: flex;
    gap: 22px;
    font-size: 15px;
  }
  .nav nav a,
  .foot nav a {
    text-decoration: none;
    color: var(--muted);
  }
  .nav nav a,
  .foot nav a {
    white-space: nowrap;
  }
  .nav nav a:hover,
  .foot nav a:hover {
    color: var(--ink);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
  }
  .mark {
    display: inline-flex;
    width: 30px;
    height: 30px;
    color: var(--ink);
  }
  .mark .accent {
    fill: var(--accent);
  }
  .mark svg {
    width: 100%;
    height: 100%;
  }
  .wordmark {
    font-family: var(--display);
    font-weight: 800;
    font-size: 22px;
    letter-spacing: -0.03em;
  }

  .eyebrow {
    font-family: var(--mono);
    font-size: 12.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  /* hero */
  .hero {
    display: flex;
    flex-direction: column;
    gap: 44px;
    padding-block: 56px 88px;
  }
  .hero-body {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: 56px;
    align-items: center;
  }
  .hero h1 {
    font-size: clamp(2.1rem, 6.2vw, 5rem);
    line-height: 1;
    font-weight: 800;
    letter-spacing: -0.045em;
    margin-block: 18px 0;
  }
  .hero h1 .beat {
    display: block;
  }
  .hero h1 .dot {
    color: var(--accent);
  }
  .lead {
    font-size: clamp(1.1rem, 2vw, 1.3rem);
    line-height: 1.5;
    color: var(--muted);
    max-width: 34em;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    padding: 13px 22px;
    border-radius: 12px;
    border: 1.5px solid var(--line);
    font-weight: 600;
    font-size: 16px;
    text-decoration: none;
    background: var(--surface);
  }
  .btn:hover {
    border-color: var(--ink);
  }
  .btn.primary {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-ink);
  }
  .btn.primary:hover {
    filter: brightness(1.06);
  }

  /* the bay */
  .bay {
    margin: 0;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 24px;
    padding: 18px;
  }
  .bay-head {
    display: flex;
    justify-content: space-between;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--muted);
    padding: 2px 4px 14px;
  }
  .slots {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }
  .slot {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }
  .slot-body {
    aspect-ratio: 1;
    border-radius: 18%;
    border: 3.5px solid var(--ink);
    transition: background 0.4s, border-color 0.4s;
    padding: 18% 16%;
  }
  .slot[data-on] .slot-body {
    background: var(--accent);
    border-color: var(--accent);
  }
  .slot .dots {
    display: none;
    align-items: center;
    gap: 8%;
  }
  .slot[data-on] .dots {
    display: flex;
  }
  .dots i {
    width: 13%;
    aspect-ratio: 1;
    border-radius: 50%;
