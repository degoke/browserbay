{
  "name": "@degoke/browserbay",
  "version": "0.1.0",
  "description": "Self-hosted browsers for AI agents and automation: a relay, browser nodes that dial out to it, and a client. Deploy it anywhere, point any project at it.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/degoke/browserbay.git"
  },
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "browserbay": "./dist/cli.js"
  },
  "exports": {
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "default": "./dist/protocol.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "prepare": "pnpm build",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && node --import tsx --test \"src/**/*.test.ts\"",
    "test:browser": "pnpm build && PLAYWRIGHT_BROWSER_TESTS=1 node --import tsx --test --test-concurrency=1 \"test/**/*.browser.test.ts\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ci": "pnpm typecheck && pnpm format:check && pnpm test",
    "start": "node dist/cli.js start",
    "docker:build": "docker build -t browserbay ."
  },
  "dependencies": {
    "ws": "^8.22.0",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.2",
    "playwright": "1.62.1",
    "prettier": "^3.5.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
